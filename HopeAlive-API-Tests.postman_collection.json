{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-1234-567890abcdef",
    "name": "Hope Alive Clock-In API Tests",
    "description": "API Tests for Supabase Auth, Employees, and Attendance endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign In with Email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"itsupporthopealiveradio@gmail.com\",\n    \"password\": \"YOUR_PASSWORD\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/auth/v1/token?grant_type=password",
              "host": ["{{supabase_url}}"],
              "path": ["auth", "v1", "token"],
              "query": [
                { "key": "grant_type", "value": "password" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "Get All Employees",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{anon_key}}", "type": "text" }
            ],
            "url": {
              "raw": "{{supabase_url}}/rest/v1/employees?select=*",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "employees"],
              "query": [
                { "key": "select", "value": "*" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Get Today's Attendance",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{anon_key}}", "type": "text" }
            ],
            "url": {
              "raw": "{{supabase_url}}/rest/v1/attendance_records?select=*",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "attendance_records"],
              "query": [
                { "key": "select", "value": "*" }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "supabase_url", "value": "https://haoxttmprwepyenguvzp.supabase.co" },
    { "key": "anon_key", "value": "YOUR_ANON_KEY" }
  ]
}
